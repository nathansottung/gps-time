[Unit]
Description=GPS Time Pi status and almanac
After=network.target chrony.service

[Service]
WorkingDirectory=/opt/gps-time-pi
Environment=GTP_CONFIG=/opt/gps-time-pi/config.json
# Optional, comma-separated: extra hostnames (e.g. a DNS name for the station)
# and reverse-proxy origins accepted by the Host/Origin checks. IP addresses,
# localhost and this machine's hostname(.local) are always accepted.
#Environment=GTP_ALLOWED_HOSTS=gpstime.example.lan
#Environment=GTP_ALLOWED_ORIGINS=https://gpstime.example.lan
# Dependencies (skyfield) live in the venv that install.sh creates.
ExecStart=/opt/gps-time-pi/venv/bin/python -m gps_time_pi.server
Restart=always

# Unprivileged (review GPS-014). Management actions go through polkit
# (/etc/polkit-1/rules.d/50-gps-time-pi.rules), which allows only restarting
# chrony/gpsd/this service, starting the log flush, and reboot.
User=gps-time
Group=gps-time
# _chrony: chrony-owned files (the RAM tracking log). The NTP client list comes
# from gps-time-pi-chrony-clients.service; this service never gets chronyd's
# control socket.
# video: vcgencmd (temperature, throttling, voltage).
SupplementaryGroups=_chrony video
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Hardening. Not PrivateDevices: the service must see /dev/pps0 to report it.
# ProtectClock: the web service can never set the system clock.
ProtectSystem=strict
ReadWritePaths=/opt/gps-time-pi
ProtectHome=yes
PrivateTmp=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0027

[Install]
WantedBy=multi-user.target
