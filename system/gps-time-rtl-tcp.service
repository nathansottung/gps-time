[Unit]
Description=rtl_tcp for GPS Time's sdr-pps-marker module (an RTL-SDR served on 127.0.0.1:1234)
Documentation=file:///opt/gps-time-pi/docs/deploy/sdr-stack.md
After=network.target

# Installed by scripts/sdr-stack.sh (sudo GTP_SDR=1 ... bash install.sh) and enabled only when
# GTP_SDR_PPS_SERIAL names an RTL-SDR serial in /etc/default/gps-time-sdr (docs/deploy/sdr-stack.md).
# Nothing here touches gpsd, chrony or the PPS line, and no receiver position is given.
# The module (in gps-time-modules.service) connects to it through the installer's drop-in,
# which allows 127.0.0.1 and nothing else.

[Service]
EnvironmentFile=/etc/default/gps-time-sdr
# No serial, no start (the unit shows "condition failed"; no restart loop).
ExecCondition=/bin/sh -c 'case "$$GTP_SDR_PPS_SERIAL" in ""|none) echo "gps-time-rtl-tcp: GTP_SDR_PPS_SERIAL is empty in /etc/default/gps-time-sdr; not started" >&2; exit 1 ;; esac'
ExecStart=/usr/bin/rtl_tcp -a 127.0.0.1 -p 1234 -s 2400000 -d ${GTP_SDR_PPS_SERIAL}
Restart=on-failure
RestartSec=10
DynamicUser=yes
SupplementaryGroups=plugdev
DevicePolicy=closed
DeviceAllow=char-usb_device rw

# The USB device and the loopback address, nothing else.
IPAddressAllow=localhost
IPAddressDeny=any
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
NoNewPrivileges=yes
SystemCallArchitectures=native
MemoryMax=128M
CPUQuota=40%

[Install]
WantedBy=multi-user.target
