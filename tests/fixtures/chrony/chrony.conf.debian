# Test fixture: the directives of Debian's default /etc/chrony/chrony.conf,
# followed by what this project adds (tools/generate_config.py, install.sh).

confdir /etc/chrony/conf.d

pool 2.debian.pool.ntp.org iburst

# Use time sources from DHCP.
sourcedir /run/chrony-dhcp

# Use NTP sources found in /etc/chrony/sources.d.
sourcedir /etc/chrony/sources.d

keyfile /etc/chrony/chrony.keys
driftfile /var/lib/chrony/chrony.drift
ntsdumpdir /var/lib/chrony
logdir /run/chrony-log
maxupdateskew 100.0
rtcsync
makestep 1 3
leapsectz right/UTC

refclock SHM 0 refid NMEA offset 0.1 delay 0.2 noselect
refclock PPS /dev/pps0 lock NMEA refid GPS prefer
allow
log tracking
